# ============================================================
# Member — autonomous worker.
# Copy to .env.member and fill in the values. Run multiple Member
# containers in parallel by reusing this file (or making variants).
#
# For local `npm run dev:member` (no Docker) you'll typically want to
# override two things:
#   - HOUSEHOLD_URL=ws://localhost:8080   (point at the dev Household)
#   - WORKSPACE_DIR=./workspace           (defaults to /workspace, which
#                                          isn't writable on a normal user
#                                          account; see the WORKSPACE_DIR
#                                          comment below)
# Docker compose overrides both via `environment:` in
# docker-compose.member.yml, so these dev values don't affect Docker.
# ============================================================

# WebSocket URL of the Household. Inside docker-compose: ws://household:8080.
# From a separate host: wss://your-household.example.com.
HOUSEHOLD_URL=ws://household:8080

# Join-token issued by Household (web UI Settings → Tokens, or seeded via
# the TokenStore at startup). The same token can be reused across many
# Member instances — token does not represent an identity, member_id does.
HOUSEHOLD_ACCESS_TOKEN=

# GitHub Personal Access Token. Member's identity (login + display name)
# is derived from `GET /user` at startup, so this PAT decides who the
# member acts as on GitHub — commits, PRs, reviews, reactions.
#
# Two members in the same Household must use PATs from DIFFERENT GitHub
# users if you want one to approve the other's PR (GitHub forbids
# self-approval). Two PATs from the same user can still both run, they
# just can't approve each other's PRs in the GitHub UI; Household tracks
# approval internally regardless.
#
# Recommended PAT scopes:
#   Fine-grained PAT (preferred): repo access on the bound repos with
#     contents=read+write, pull_requests=read+write, issues=read+write,
#     metadata=read.
#   Classic PAT: `repo` is enough; add `workflow` only if the agent must
#     touch GitHub Actions files.
GITHUB_PAT=

# Comma-separated skills from: implement, review, triage, respond, summarize,
# preview. Default = all. Restrict to dedicate cheaper workers to e.g. review
# only, or a beefier host to `preview` (runs project dev servers).
# (Note: `estimate` is deprecated as of protocol 2.2.0 — its analytical work
# is folded into `triage`. Old members can keep `estimate` in the list, but
# Household no longer dispatches that kind.)
SKILLS=implement,review,triage,respond,summarize,preview

# Repo allowlist isn't configured here — Member auto-discovers it at startup
# from `GET /user/repos` using GITHUB_PAT, and tells Household which repos
# it can work on. Scope your fine-grained PAT to the repos you want this
# Member to touch and that's the allowlist.

# Hint for dispatch + agent thoroughness: hard | medium | lazy. Default medium.
WORKER_PROFILE=medium

# ----- LLM provider (Anthropic supported in M3; Gemini/OpenAI in M6) -----
AI_PROVIDER=anthropic
AI_MODEL=claude-opus-4-7
AI_API_KEY=

# Set AI_API_KEY=fake to run the offline stub provider. Useful for smoke
# testing the workspace + commit + PR pipeline without burning tokens.

# ----- Self-imposed limits (Member enforces, Household only logs) -----
# Empty = unlimited. Hard wallclock limit is always enforced.
MAX_TOKENS_PER_TASK=
MAX_TOKENS_PER_DAY=
MAX_TASK_DURATION_MINUTES=120

# Workspace volume mountpoint. Default matches the Docker volume
# (`/workspace`); leave it as that for Docker compose. For non-Docker
# `npm run dev:member`, set this to a path your user can write to —
# `./workspace` (relative to `member/`, gitignored) is the convention.
# WORKSPACE_DIR=/workspace

# ----- Preview skill (runs a project's dev server on a branch) -----
# Port the dev server is asked to bind (injected as PORT). Default 4321.
# PREVIEW_BASE_PORT=4321
# How long to wait for the server to print its URL before assuming localhost.
# PREVIEW_READY_TIMEOUT_MS=120000
# How the preview is exposed: `local` (report the Member-local URL) or
# `household` (report a stable <household>/previews/<task> link that Household
# redirects to the live server). Default local.
# PREVIEW_PUBLISH_MODE=local

# pino log level
LOG_LEVEL=info
